#!/usr/bin/env bash
set -euo pipefail
umask 077
# Collection must never mutate the extracted source tree, even under sudo.
export PYTHONDONTWRITEBYTECODE=1

# Resolve symlinks so installation via /usr/local/bin/linux-context -> checkout/bin/linux-context
# still finds the adjacent lib/, collectors/, profiles/, and VERSION files.
_script=${BASH_SOURCE[0]}
if command -v readlink >/dev/null 2>&1; then
    _resolved=$(readlink -f -- "$_script" 2>/dev/null || true)
    [[ -n "$_resolved" ]] && _script=$_resolved
fi
LCTX_PROJECT_ROOT=$(cd -- "$(dirname -- "$_script")/.." && pwd -P)
export LCTX_PROJECT_ROOT

source "$LCTX_PROJECT_ROOT/lib/common.sh"
source "$LCTX_PROJECT_ROOT/lib/profile.sh"
source "$LCTX_PROJECT_ROOT/lib/redact.sh"
source "$LCTX_PROJECT_ROOT/lib/bundle.sh"

[[ -r "$LCTX_PROJECT_ROOT/VERSION" ]] || fatal 'VERSION file is missing from the project root.'
IFS= read -r LCTX_VERSION < "$LCTX_PROJECT_ROOT/VERSION" || true
[[ "$LCTX_VERSION" =~ ^[0-9]+\.[0-9]+\.[0-9]+([.-][0-9A-Za-z.-]+)?$ ]] || fatal "Invalid VERSION value: $LCTX_VERSION"

LCTX_PROFILE='standard'
LCTX_TARGETS='auto'
LCTX_OUTPUT_DIR=''
LCTX_ARCHIVE=1
LCTX_KEEP_DIR=1
LCTX_LIST_COLLECTORS=0
LCTX_LIST_TARGETS=0
LCTX_JOBS_OVERRIDE=''

usage() {
    cat <<'USAGE'
linux-context - read-only Linux state exporter optimized for AI understanding

Usage:
  linux-context [options]

Options:
  --profile quick|standard|deep|max   Collection depth (default: standard)
  --target NAME[,NAME...]             auto, all, or explicit target(s)
  --jobs N                            Concurrent collectors (1..8; profile default)
  --output DIR                        Bundle directory path
  --no-archive                        Do not create .tar.gz archive
  --remove-dir-after-archive          Remove unpacked bundle after archiving
  --list-collectors                   List collector metadata
  --list-targets                      List supported target names
  -V, --version                       Show version
  -h, --help                          Show help

Recommended:
  sudo ./bin/linux-context --profile max
      Deepest sensible automatic whole-machine snapshot for initial AI use.

  sudo ./bin/linux-context --profile max --target all
      Exhaustive target-specific diagnostic acquisition, still bounded/read-only/redacted.

AI contract:
  context.ai.json                     Lossless dictionary-coded AI view.
  context.json                        Canonical compact typed host graph/index.
  meta/evidence.json                  Evidence routing catalog; open only on demand.
  meta/collection.json                Collector/probe telemetry; not host context.
  sections/                           Bounded redacted evidence; inspect only on demand.
  meta/redaction.json                 Final credential/privacy-risk scan result.
  meta/validation.json                Structural integrity result.

Profiles control depth/budget. Targets control where extra diagnostic detail is
spent. `max --target auto` is the recommended complete AI snapshot; `max
--target all` is deliberately more exhaustive and may be slower/larger.
USAGE
}

while (( $# )); do
    case "$1" in
        --profile) [[ $# -ge 2 ]] || fatal '--profile requires a value'; LCTX_PROFILE="$2"; shift 2 ;;
        --target) [[ $# -ge 2 ]] || fatal '--target requires a value'; LCTX_TARGETS="$2"; shift 2 ;;
        --jobs) [[ $# -ge 2 ]] || fatal '--jobs requires a value'; LCTX_JOBS_OVERRIDE="$2"; shift 2 ;;
        --output) [[ $# -ge 2 ]] || fatal '--output requires a value'; LCTX_OUTPUT_DIR="$2"; shift 2 ;;
        --no-archive) LCTX_ARCHIVE=0; shift ;;
        --remove-dir-after-archive) LCTX_KEEP_DIR=0; shift ;;
        --list-collectors) LCTX_LIST_COLLECTORS=1; shift ;;
        --list-targets) LCTX_LIST_TARGETS=1; shift ;;
        -V|--version) printf 'linux-context %s\n' "$LCTX_VERSION"; exit 0 ;;
        -h|--help) usage; exit 0 ;;
        *) fatal "Unknown option: $1" ;;
    esac
done

export LCTX_VERSION LCTX_PROFILE LCTX_TARGETS LCTX_OUTPUT_DIR
case "$LCTX_PROFILE" in quick|standard|deep|max) ;; *) fatal "Unknown profile: $LCTX_PROFILE";; esac
[[ -n "$LCTX_TARGETS" && "$LCTX_TARGETS" != ,* && "$LCTX_TARGETS" != *, && "$LCTX_TARGETS" != *,,* ]] || fatal 'empty target name'
(( LCTX_ARCHIVE || LCTX_KEEP_DIR )) || fatal '--remove-dir-after-archive requires archive output'

# Successful collection requires these dependencies for every profile. Keeping one
# production security path is safer than silently degrading on lower profiles.
command_exists python3 || fatal 'Python 3.9+ is required for typed compilation and redaction.'
lctx_python -c 'import sys; sys.exit(sys.version_info < (3, 9))' || fatal 'Python 3.9+ is required.'
(( BASH_VERSINFO[0] >= 4 )) || fatal 'Bash 4.0+ is required.'
if (( LCTX_ARCHIVE )); then command_exists tar || fatal 'tar is required for archive output.'; fi
init_execution_backend

load_profile "$LCTX_PROFILE"
if [[ -n "$LCTX_JOBS_OVERRIDE" ]]; then LCTX_JOBS="$LCTX_JOBS_OVERRIDE"; fi
[[ "$LCTX_JOBS" =~ ^[1-8]$ ]] || fatal '--jobs/profile LCTX_JOBS must be an integer from 1 to 8'
export LCTX_JOBS

init_redaction
[[ "$LCTX_REDACTION_ASSURANCE" == enhanced ]] || fatal 'Enhanced redaction assurance is mandatory.'

mapfile -t collectors < <(find "$LCTX_PROJECT_ROOT/collectors" -type f -name '*.sh' | LC_ALL=C sort)
(( ${#collectors[@]} )) || fatal 'No executable collectors found.'
# Metadata is immutable for a run. Read it once rather than starting every
# collector repeatedly for target discovery, scheduling, and stage setup.
collector_metadata=()
for collector in "${collectors[@]}"; do
    [[ -x "$collector" ]] || fatal "Collector is not executable: $collector"
    meta=$(lctx_timeout 5 "$collector" --meta) || fatal "Unable to read collector metadata: $collector"
    collector_metadata+=("$meta")
done

if (( LCTX_LIST_COLLECTORS )); then
    printf 'ID\tMIN_PROFILE\tTARGETS\tPRIVILEGE\tBASELINE\tDESCRIPTION\n'
    printf '%s\n' "${collector_metadata[@]}"
    exit 0
fi

supported_targets() {
    local collector meta id min targets privilege baseline description token
    printf '%s\n' auto all
    for meta in "${collector_metadata[@]}"; do
        IFS=$'\t' read -r id min targets privilege baseline description <<< "$meta"
        for token in $targets; do printf '%s\n' "$token"; done
    done | LC_ALL=C sort -u
}

if (( LCTX_LIST_TARGETS )); then supported_targets; exit 0; fi

# Validate and canonicalize the target expression once.
mapfile -t _supported < <(supported_targets)
IFS=',' read -ra _requested <<< "$LCTX_TARGETS"
_normalized_requested=()
_special_target=''
for _target in "${_requested[@]}"; do
    normalize_one_line_into _target "$_target"
    [[ -n "$_target" ]] || fatal 'empty target name'
    printf '%s\n' "${_supported[@]}" | grep -Fxq -- "$_target" || fatal "Unknown target: $_target (use --list-targets)"
    _normalized_requested+=("$_target")
    if [[ "$_target" == auto || "$_target" == all ]]; then _special_target="$_target"; fi
done
if [[ -n "$_special_target" && ${#_normalized_requested[@]} -ne 1 ]]; then
    fatal "--target $_special_target must be used alone"
fi
LCTX_TARGETS=$(IFS=,; printf '%s' "${_normalized_requested[*]}")
export LCTX_TARGETS

init_bundle
on_exit() {
    local rc=$?
    trap - EXIT
    trap '' INT TERM
    # Background shells can ignore terminal SIGINT and continue writing into
    # staging. Stop and reap their full trees before removing private material.
    local -a workers=()
    mapfile -t workers < <(jobs -pr)
    if (( ${#workers[@]} )); then
        if ! lctx_python "$LCTX_PROJECT_ROOT/lib/stop_workers.py" "${workers[@]}"; then
            log ERROR "Unable to stop collectors; private staging retained at $LCTX_TMP_DIR"
            exit "$rc"
        fi
        wait || true
    fi
    cleanup_tmp || true
    exit "$rc"
}
trap on_exit EXIT
trap 'exit 130' INT
trap 'exit 143' TERM
lctx_python "$LCTX_PROJECT_ROOT/lib/catalog.py" "$LCTX_STAGE_ROOT" "${collector_metadata[@]}" || fatal 'Invalid collector catalog'

matches_target() {
    local collector_targets="$1" baseline="$2" token ctoken
    local -a requested=()
    target_is_auto && return 0
    target_is_all && return 0
    [[ "$baseline" == 1 ]] && return 0
    IFS=',' read -ra requested <<< "$LCTX_TARGETS"
    for token in "${requested[@]}"; do
        normalize_one_line_into token "$token"
        for ctoken in $collector_targets; do [[ "$token" == "$ctoken" ]] && return 0; done
    done
    return 1
}

run_collector() {
    local collector="$1" meta="$2" id min_profile targets privilege baseline description safe stage start_ms end_ms duration rc phase detected status detail
    IFS=$'\t' read -r id min_profile targets privilege baseline description <<< "$meta"
    safe_name_into safe "$id"
    stage="$LCTX_STAGE_ROOT/collectors/$safe"
    epoch_millis_into start_ms
    status='collected'; detail="$description"

    if ! profile_allows "$LCTX_PROFILE" "$min_profile"; then
        status='skipped'; detail="requires profile >= $min_profile"
    elif ! matches_target "$targets" "$baseline"; then
        status='skipped'; detail='target mismatch'
    elif [[ "$privilege" == root && "$EUID" -ne 0 ]]; then
        status='unavailable'; detail='requires root'
    else
        log INFO "inspecting $id"
        set +e
        LCTX_SECTION_DIR="$LCTX_STAGE_ROOT/evidence/$safe" \
        LCTX_FACTS_RECORDS="$stage/facts.records" \
        LCTX_ENTITIES_RECORDS="$stage/entities.records" \
        LCTX_ENTITY_ATTRS_RECORDS="$stage/entity-attrs.records" \
        LCTX_RELATIONS_RECORDS="$stage/relations.records" \
        LCTX_ARTIFACTS_RECORDS="$stage/artifacts.records" \
        LCTX_PROBES_RECORDS="$stage/probes.records" \
        LCTX_NOTES_FILE="$stage/notes.tsv" \
        lctx_python "$LCTX_PROJECT_ROOT/lib/timeout.py" --collector "$collector" "$((LCTX_COMMAND_TIMEOUT * 12))" "$stage/detect-status"
        rc=$?
        set -e
        [[ -r "$stage/detect-status" ]] || fatal "Supervisor did not report detection: $id"
        read -r phase detected < "$stage/detect-status"
        [[ "$detected" =~ ^[0-9]+$ ]] || fatal "Invalid supervisor detection status: $id"
        if [[ "$phase" == detect ]]; then
            status='unavailable'; detail='not detected or not accessible'
            (( detected == 124 || detected == 137 )) && detail='detection timed out'
        elif [[ "$phase" == run && "$detected" == "$rc" ]]; then
            if (( rc != 0 )); then status='partial'; detail="collector exit $rc"; fi
        else
            fatal "Invalid supervisor completion status: $id"
        fi
    fi
    epoch_millis_into end_ms; duration=$((end_ms-start_ms))
    normalize_one_line_into detail "$detail"
    printf '%s\t%s\t%s\t%s\n' "$id" "$status" "$duration" "$detail" > "$stage/status.tsv"
    return 0
}

# Collectors write to isolated per-collector staging trees, so they are safe to
# run concurrently. Prefer a rolling worker window when Bash supports wait -n.
if help wait 2>/dev/null | grep -q -- '-n'; then
    active_jobs=0
    for index in "${!collectors[@]}"; do
        run_collector "${collectors[$index]}" "${collector_metadata[$index]}" &
        active_jobs=$((active_jobs+1))
        if (( active_jobs >= LCTX_JOBS )); then
            wait -n || true
            active_jobs=$((active_jobs-1))
        fi
    done
    while (( active_jobs > 0 )); do wait -n || true; active_jobs=$((active_jobs-1)); done
else
    pids=()
    for index in "${!collectors[@]}"; do
        run_collector "${collectors[$index]}" "${collector_metadata[$index]}" & pids+=("$!")
        if (( ${#pids[@]} >= LCTX_JOBS )); then
            for pid in "${pids[@]}"; do wait "$pid" || true; done
            pids=()
        fi
    done
    for pid in "${pids[@]}"; do wait "$pid" || true; done
fi

log INFO 'pruning raw evidence to aggregate profile budget before redaction'
prune_staging_evidence || fatal 'pre-redaction evidence pruning/validation failed'
log INFO 'redacting and scanning private collector staging'
secure_staging || fatal 'private staging redaction/residual scan failed; no raw evidence was released'
install_sanitized_stage
log INFO 'compiling compact canonical AI context'
compile_context || fatal "canonical context compilation/validation failed: $LCTX_OUTPUT_DIR/meta/validation.json"
# Share one interpreter/compiled redaction engine across all final gates.
log INFO 'finalizing redaction, integrity, lossless AI view and manifest'
lctx_python "$LCTX_PROJECT_ROOT/lib/finalize.py" "$LCTX_OUTPUT_DIR" || fatal 'final bundle redaction/integrity/AI/privacy gate failed'
publish_bundle

archive_path=''
if (( LCTX_ARCHIVE )); then archive_path=$(archive_bundle); fi
cleanup_tmp
if (( LCTX_ARCHIVE && ! LCTX_KEEP_DIR )); then remove_published_bundle; fi

printf 'Bundle: %s\n' "$LCTX_OUTPUT_DIR"
if (( LCTX_KEEP_DIR )); then printf 'AI context: %s/context.ai.json\n' "$LCTX_OUTPUT_DIR"; fi
if [[ -n "$archive_path" ]]; then printf 'Archive: %s\n' "$archive_path"; fi
exit 0
